# Copier en .env.local pour le développement. Ne jamais versionner de vraies valeurs.

# ── Prototype (aucune variable obligatoire) ──────────────────────────────
# URL canonique du site (sans slash final). Facultatif : sur Vercel, le domaine
# de production est détecté automatiquement.
NEXT_PUBLIC_SITE_URL=

# Autoriser l'indexation Google. Ne passer à "true" qu'au moment où la refonte
# remplace réellement www.kiraparis.com (sinon contenu dupliqué avec le site Shopify).
ALLOW_INDEXING=false

# ── Phase suivante : connexion Shopify (pas encore utilisées par le code) ─
# SHOPIFY_STORE_DOMAIN=xxxx.myshopify.com
# SHOPIFY_STOREFRONT_ACCESS_TOKEN=
# SHOPIFY_STOREFRONT_PRIVATE_TOKEN=
# SHOPIFY_REVALIDATION_SECRET=
# JUDGEME_PUBLIC_TOKEN=
